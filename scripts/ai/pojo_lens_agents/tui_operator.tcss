}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
OptionList {
    height: 7;
    margin-bottom: 1;
}
#cost-note {
    color: $amber;
    margin-top: 1;
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

