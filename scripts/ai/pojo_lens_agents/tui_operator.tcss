}
SettingsScreen .set-label {
    color: $text_dim;
    margin-top: 1;
    margin-bottom: 0;
}
#f-api-key-status {
    color: $text_dim;
    margin-bottom: 1;
    padding-left: 1;
}
SettingsScreen Input {
    width: 60;
    background: $bg_input;
    border: tall $green_dim;
    color: $text;
}
SettingsScreen Input:focus {
    border: tall $cyan;
}
SettingsScreen Select {
    width: 60;
    background: $bg_input;
    border: tall $green_dim;
    color: $text;
}
SettingsScreen Select:focus {
    border: tall $cyan;
}
#action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: right middle;
    padding: 0 2;
}

/* ── DiffReviewScreen ────────────────────────────────────────────────────── */
DiffReviewScreen { background: $bg; }
#top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#diff-title  { color: $cyan; text-style: bold; }
#diff-ref    { color: $text_dim; }
#diff-status { color: $green; margin-top: 1; }
#diff-stats  {
    height: 1;
    background: $bg_panel;
    color: $green_body;
    padding: 0 2;
    border-bottom: solid $green_dim;
}
#split-view  { height: 1fr; layout: horizontal; }
#file-list   { width: 42; border-right: heavy $green 20%; }
#diff-log    { width: 1fr; }
#action-bar  {
    height: 3;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── AgentsScreen ────────────────────────────────────────────────────────── */
AgentsScreen { background: $bg; }
AgentsScreen #top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#ag-title { color: $cyan; text-style: bold; }
#ag-path  { color: $text_dim; }
#ag-split {
    height: 1fr;
    layout: vertical;
}
#ag-table {
