    border-bottom: solid $green 20%;
    padding: 0 1;
    align: left middle;
}
#query-label { color: $cyan; width: 10; }
#query-input { width: 1fr; }
#mem-log   { height: 1fr; }
#action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

