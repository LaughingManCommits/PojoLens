/* ── RunDetailsScreen ────────────────────────────────────────────────────── */
RunDetailsScreen {
    background: $bg;
}
RunDetailsScreen #top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
