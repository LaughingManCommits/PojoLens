/* ── Shared / Global ─────────────────────────────────────────────────────── */
Screen {
    background: $bg;
    color: $green_body;
}
Header {
    background: $bg_panel;
    color: $green;
    border-bottom: heavy $green 30%;
}
Footer {
    background: $bg_input;
    color: $text_dim;
    border-top: solid $green 20%;
}
.panel {
    background: $bg_panel;
    border: heavy $green 25%;
    padding: 1 2;
    margin: 0 0 1 0;
}
.panel-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
.section-rule {
    color: $green_dim;
}
/* ── Section dividers  [ NAME ]  — neon cyan ────────────────────────── */
.section-hdr {
    color: $cyan;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
}
.dim {
    color: $text_dim;
}
.warn {
    color: $amber;
}
.error {
    color: $red;
}
.ok {
    color: $green;
}
.accent {
    color: $cyan;
}
/* ── Global button styles ─────────────────────────────────────────────── */
Button {
    margin: 0 1;
    background: $bg_panel;
    color: $green_body;
    border: solid $green_dim;
    min-width: 10;
    padding: 0 2;
}
Button:hover {
    background: $green_dim;
    color: $green;
    border: solid $green;
}
Button:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

Button.-primary {
    background: #001a08;
    color: $green;
    border: solid $green;
}
Button.-primary:hover    { background: #002a10; }
Button.-primary:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

Button.-warning {
    background: #2a1400;
    color: $amber;
    border: solid $amber;
}
Button.-warning:hover    { background: #3a1e00; }
Button.-warning:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

Button.-error {
    background: #280008;
    color: $red;
    border: solid $red;
}
Button.-error:hover    { background: #380010; }
Button.-error:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

Button.-success {
    background: #001530;
    color: $cyan;
    border: solid $cyan;
}
Button.-success:hover    { background: #002040; }
Button.-success:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

/* ── Semantic button IDs — consistent color across all screens ────────── */
#btn-resume, #btn-ledger {
    background: #001530;
    color: $cyan;
    border: solid $cyan;
}
#btn-resume:disabled, #btn-ledger:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

#btn-retry {
    background: #2a1400;
    color: $amber;
    border: solid $amber;
}
#btn-retry:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

#btn-gate, #btn-abort {
    background: #280008;
    color: $red;
    border: solid $red;
}
#btn-gate:disabled, #btn-abort:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}

/* ── Pagination buttons — compact, cyan ───────────────────────────────── */
#btn-run-prev, #btn-run-next, #btn-prev, #btn-next,
#btn-ag-prev, #btn-ag-next, #btn-sk-prev, #btn-sk-next,
#btn-dash-pg-prev, #btn-dash-pg-next,
#btn-dash-tpg-prev, #btn-dash-tpg-next {
    background: $bg_panel;
    color: $cyan;
    border: solid $cyan;
    min-width: 5;
    padding: 0 1;
}
#btn-run-prev:disabled, #btn-run-next:disabled,
#btn-prev:disabled,     #btn-next:disabled,
#btn-ag-prev:disabled,  #btn-ag-next:disabled,
#btn-sk-prev:disabled,  #btn-sk-next:disabled,
#btn-dash-pg-prev:disabled,  #btn-dash-pg-next:disabled,
#btn-dash-tpg-prev:disabled, #btn-dash-tpg-next:disabled {
    background: $bg_panel;
    color: $text_dim;
    border: solid $text_dim 30%;
}
Input {
    background: $bg_input;
    color: $green;
    border: solid $green 40%;
}
Input:focus {
    border: solid $cyan;
    color: $cyan;
}
OptionList {
    background: $bg;
    border: solid $green_dim;
    color: $green_body;
}
OptionList > .option-list--option-highlighted {
    background: $green_dim;
    color: $green;
    text-style: bold;
}
DataTable {
    background: $bg_panel;
    color: $green_body;
}
DataTable > .datatable--header {
    background: $bg_input;
    color: $cyan;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: $green_dim;
}
DataTable > .datatable--even-row {
    background: $bg_panel;
}
DataTable > .datatable--odd-row {
    background: $bg;
}
RichLog {
    background: $bg;
    padding: 0 1;
    color: $green_body;
    scrollbar-color: $green 25%;
    scrollbar-background: $bg;
}
LoadingIndicator {
    color: $green;
    background: $bg;
}
Select {
    background: $bg_input;
    color: $green;
    border: solid $green 40%;
}
Select:focus {
    border: solid $cyan;
    color: $cyan;
}
SelectionList {
    background: $bg_input;
    border: tall $green_dim;
    color: $green_body;
}
SelectionList:focus { border: tall $cyan; }
SelectionList > .selection-list--button-highlighted {
    background: $green_dim;
    color: $green;
    text-style: bold;
}
SelectionList > .selection-list--button-selected {
    color: $cyan;
}
/* ── Common layout primitives (all screens) ─────────────────────────── */
#top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#screen-title {
    color: $cyan;
    text-style: bold;
}
#screen-hint {
    color: $text_dim;
}
#action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── GoalInputScreen ─────────────────────────────────────────────────────── */
GoalInputScreen {
    align: center middle;
}
#card {
    width: 76;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
#hint {
    color: $text_dim;
    margin-top: 1;
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* ── ClarificationScreen ─────────────────────────────────────────────────── */
ClarificationScreen {
    align: center middle;
}
#card {
    width: 82;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#cl-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#cl-wip {
    color: $amber;
    margin-bottom: 1;
}
#cl-goal-box {
    background: $bg_input;
    border: solid $green_dim;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}
#cl-goal-label { color: $cyan; }
#cl-goal-text  { color: $green_body; }
#cl-separator  { color: $green_dim; margin: 1 0; }
#cl-q-label {
    color: $cyan;
    text-style: bold;
    margin-bottom: 0;
}
#cl-q-text {
    color: $green_body;
    margin-bottom: 1;
}
#cl-progress {
    color: $text_dim;
    margin-bottom: 1;
}
#cl-answers {
    background: $bg_input;
    border: solid $green_dim;
    padding: 0 1;
    height: auto;
    margin-bottom: 1;
}
#cl-input {
    margin-top: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* ── EffortSelectScreen ──────────────────────────────────────────────────── */
EffortSelectScreen {
    align: center middle;
}
#card {
    width: 72;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
OptionList {
    height: 7;
    margin-bottom: 1;
}
#cost-note {
    color: $amber;
    margin-top: 1;
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* ── WorkspaceModeScreen ─────────────────────────────────────────────────── */
WorkspaceModeScreen {
    align: center middle;
}
#card {
    width: 76;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
OptionList {
    height: 7;
    margin-bottom: 1;
}
#ws-warning {
    color: $amber;
    margin-top: 1;
    margin-bottom: 1;
}
#ws-source-label {
    color: $green;
    margin-top: 1;
}
#ws-source-input {
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* GovernanceScreen is an alias for RunConfigScreen — no separate CSS needed */

/* ── RunConfigScreen ─────────────────────────────────────────────────────── */
RunConfigScreen {
    align: center middle;
}
RunConfigScreen #card {
    width: 88;
    height: 1fr;
    max-height: 54;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#provider-list        { height: 7; margin-bottom: 1; }
#hitl-list            { height: 7; margin-bottom: 1; }
#budget-behavior-list { height: 7; margin-bottom: 1; }
#followup-list        { height: 7; margin-bottom: 1; }
#prov-config-note { color: $text_dim; height: auto; }
#prov-meta { color: $text_dim; height: auto; }
#gov-title { color: $cyan; text-style: bold; margin-top: 1; }

/* ── PromoteConfirmDialog ────────────────────────────────────────────────── */
PromoteConfirmDialog {
    align: center middle;
    background: $bg 60%;
}
PromoteConfirmDialog #confirm-dialog {
    width: 72;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
PromoteConfirmDialog #confirm-title { color: $cyan; text-style: bold; margin-bottom: 1; }
PromoteConfirmDialog #confirm-ref   { color: $text_dim; margin-bottom: 1; }
PromoteConfirmDialog #confirm-msg   { color: $amber; margin-bottom: 1; }
PromoteConfirmDialog #btns          { height: auto; align: right middle; margin-top: 1; }

/* ── PlanRunScreen (wizard + plan run — shared screen) ───────────────────── */
PlanRunScreen {
    background: $bg;
}
PlanRunScreen #top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#run-title  { color: $cyan; text-style: bold; }
#run-plan   { color: $text_dim; }
#run-status { color: $green; margin-top: 1; }
#run-progress-bar {
    height: 1;
    background: $bg_input;
    border-bottom: solid $green_dim;
    padding: 0 2;
    align: left middle;
}
#run-prog-label { color: $text_dim; width: auto; }
#run-prog-bar   { color: $green;    width: 1fr;  }
#run-prog-cost  { color: $amber;    width: auto; }
#run-task-table {
    height: 12;
    border: solid $cyan 30%;
    margin: 0 1 0 1;
}
#run-log { height: 1fr; min-height: 4; }
PlanRunScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── SavedPlansScreen ────────────────────────────────────────────────────── */
SavedPlansScreen {
    background: $bg;
}
#search-bar {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green 20%;
    padding: 0 1;
}
#search-input {
    width: 1fr;
}
#plans-stats {
    height: 1;
    background: $bg_panel;
    color: $green_body;
    padding: 0 2;
    border-bottom: solid $green_dim;
}
#plans-table {
    height: 1fr;
}
#empty-notice {
    color: $text_dim;
    text-align: center;
    margin: 4;
}
#pagination-bar {
    height: 3;
    background: $bg_input;
    border-top: solid $green_dim;
    align: center middle;
    padding: 0 1;
}
#page-label {
    color: $cyan;
    width: 1fr;
    text-align: center;
}
#btn-prev, #btn-next { min-width: 5; }

/* ── PlanDetailsScreen ───────────────────────────────────────────────────── */
PlanDetailsScreen {
    background: $bg;
}
#plan-path {
    color: $text_dim;
}
#details-log {
    height: 1fr;
}
PlanDetailsScreen #action-bar {
    height: 7;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── PlanEditorScreen ────────────────────────────────────────────────────── */
PlanEditorScreen { background: $bg; }
PlanEditorScreen #ed-title  { color: $cyan; text-style: bold; }
PlanEditorScreen #ed-path   { color: $text_dim; }
PlanEditorScreen #ed-status { color: $green; margin-top: 1; }
PlanEditorScreen #ed-split {
    height: 1fr;
}
PlanEditorScreen #set-form {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    border-right: heavy $green 20%;
}
PlanEditorScreen #json-pane {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}
PlanEditorScreen #json-pane-title {
    color: $cyan;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}
PlanEditorScreen #json-log {
    height: 1fr;
}
/* .section-hdr global rule handles color: $cyan; text-style: bold */
PlanEditorScreen .section-hdr {
    margin-top: 2;
    margin-bottom: 1;
}
PlanEditorScreen TextArea {
    height: 8;
    border: tall $green_dim;
    background: $bg_input;
    margin-bottom: 1;
}
PlanEditorScreen TextArea:focus { border: tall $cyan; }
PlanEditorScreen SelectionList {
    height: 10;
    border: tall $green_dim;
    background: $bg_input;
    color: $green_body;
    margin-bottom: 1;
}
PlanEditorScreen SelectionList:focus { border: tall $cyan; }
PlanEditorScreen #task-table {
    height: 10;
    margin-top: 1;
}
PlanEditorScreen #task-actions {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

/* ── TaskEditModal ───────────────────────────────────────────────────────── */
TaskEditModal {
    align: center middle;
    background: $bg 60%;
}
TaskEditModal #modal-card {
    width: 84;
    min-height: 44;
    max-height: 92%;
    layout: vertical;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 1 2 0 2;
}
TaskEditModal #modal-title {
    color: $cyan;
    text-style: bold;
    height: auto;
}
TaskEditModal #set-form {
    height: 1fr;
    padding: 0 1;
}
TaskEditModal TextArea {
    height: 8;
    border: tall $green_dim;
    background: $bg_input;
    margin-bottom: 1;
}
TaskEditModal TextArea:focus { border: tall $cyan; }
TaskEditModal SelectionList {
    height: 10;
    border: tall $green_dim;
    background: $bg_input;
    color: $green_body;
    margin-bottom: 1;
}
TaskEditModal SelectionList:focus { border: tall $cyan; }
TaskEditModal #modal-btns {
    height: 4;
    margin-top: 1;
    align: right middle;
}

/* RunPlanScreen is an alias for PlanRunScreen — no separate CSS needed */

/* ── ValidatePlanDialog (modal) ──────────────────────────────────────────── */
ValidatePlanDialog {
    align: center middle;
    background: $bg 60%;
}
ValidatePlanDialog #card {
    width: 76;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
ValidatePlanDialog #card-title { color: $cyan; text-style: bold; margin-bottom: 1; }
ValidatePlanDialog #btns { height: auto; align: right middle; margin-top: 1; }

/* ── ValidateRunScreen ───────────────────────────────────────────────────── */
ValidateRunScreen { background: $bg; }
#val-title { color: $cyan; text-style: bold; }
#val-path  { color: $text_dim; }
ValidateRunScreen #val-loading { height: 1fr; }
ValidateRunScreen #val-body {
    height: 1fr;
    padding: 1 3;
}
ValidateRunScreen #val-banner {
    height: auto;
    text-align: center;
    padding: 1 2;
    margin: 0 0 1 0;
    border: heavy $green 30%;
    text-style: bold;
}
ValidateRunScreen .val-hdr {
    color: $cyan;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
}
ValidateRunScreen .val-hdr-err {
    color: $red;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
}
ValidateRunScreen .val-row {
    height: auto;
    margin-bottom: 0;
}
ValidateRunScreen .val-label {
    width: 12;
    color: $text_dim;
}
ValidateRunScreen .val-value {
    width: 1fr;
    color: $green_body;
}
ValidateRunScreen #tasks-table {
    height: 12;
    margin-top: 1;
    margin-bottom: 1;
    border: tall $green_dim;
}
ValidateRunScreen #issues-list {
    height: auto;
    margin-left: 2;
    margin-bottom: 1;
}

/* ── RunLedgerScreen ─────────────────────────────────────────────────────── */
RunLedgerScreen {
    background: $bg;
}
#runs-table   { height: 1fr; }
#empty-notice {
    color: $text_dim;
    text-align: center;
    margin: 4;
}
RunLedgerScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}


/* ── RunDetailsScreen ────────────────────────────────────────────────────── */
RunDetailsScreen {
    background: $bg;
}
RunDetailsScreen #run-title      { color: $cyan; text-style: bold; }
RunDetailsScreen #run-ref        { color: $text_dim; }
RunDetailsScreen #run-status-line { color: $green;      margin-top: 1; }
RunDetailsScreen #run-plan-line   { color: $green_body; margin-top: 1; }
RunDetailsScreen #detail-split {
    height: 1fr;
}
RunDetailsScreen #detail-left {
    width: 2fr;
    border-right: solid $green 20%;
}
RunDetailsScreen #detail-right {
    width: 3fr;
}
RunDetailsScreen #tasks-title {
    color: $cyan;
    text-style: bold;
    background: $bg_panel;
    padding: 0 1;
}
RunDetailsScreen #tasks-table {
    height: auto;
    max-height: 12;
}
RunDetailsScreen #events-title {
    color: $cyan;
    text-style: bold;
    background: $bg_panel;
    padding: 0 1;
}
RunDetailsScreen #events-log { height: 1fr; }
RunDetailsScreen #diff-header {
    color: $cyan;
    text-style: bold;
    background: $bg_panel;
    padding: 0 1;
}
RunDetailsScreen #diff-file-list {
    height: auto;
    max-height: 10;
    border-bottom: solid $green 20%;
}
RunDetailsScreen #diff-log { height: 1fr; }
RunDetailsScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: right middle;
    padding: 0 2;
}

/* ── ResumeRetryScreen ───────────────────────────────────────────────────── */
ResumeRetryScreen {
    background: $bg;
}
#rr-title  { color: $cyan; text-style: bold; }
#rr-ref    { color: $text_dim; }
#rr-status { color: $green; margin-top: 1; }
#rr-log    { height: 1fr; }

/* ── HitlGateScreen ──────────────────────────────────────────────────────── */
HitlGateScreen {
    background: $bg;
}
#gate-header {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $amber 40%;
    padding: 1 2;
}
#gate-title {
    color: $amber;
    text-style: bold;
}
#gate-id {
    color: $green_body;
    margin-top: 1;
}
#gate-wip {
    color: $text_dim;
    margin-top: 0;
}
#main-split {
    height: 1fr;
    layout: horizontal;
}
#left-panel {
    width: 1fr;
    background: $bg_panel;
    border-right: heavy $green 20%;
    padding: 1 2;
}
#right-panel {
    width: 1fr;
    background: $bg_panel;
    padding: 1 2;
}
#left-panel .panel-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#right-panel .panel-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#batch-log {
    height: 1fr;
}
#pending-table {
    height: 1fr;
}
#cost-bar {
    height: 3;
    background: $bg_input;
    border-top: solid $green_dim;
    border-bottom: solid $green_dim;
    padding: 0 2;
    align: left middle;
}
#cost-display {
    color: $green_body;
}
#gate-actions {
    height: 3;
    background: $bg_input;
    border-top: heavy $amber 40%;
    align: left middle;
    padding: 0 1;
}

/* ── MemoryToolsScreen ───────────────────────────────────────────────────── */
MemoryToolsScreen {
    background: $bg;
}
#mem-title  { color: $cyan; text-style: bold; }
#mem-hint   { color: $text_dim; }
#mem-status { color: $green; height: 1; margin-top: 1; }
#mem-desc   { color: $green_body; margin-top: 1; }
#query-bar {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green 20%;
    padding: 0 1;
    align: left middle;
}
#query-label { color: $cyan; width: 10; }
#query-input { width: 1fr; }
#mem-log   { height: 1fr; }

/* ── SettingsScreen ──────────────────────────────────────────────────────── */
SettingsScreen {
    background: $bg;
}
#set-title { color: $cyan; text-style: bold; }
#set-path  { color: $text_dim; margin-top: 1; }
#set-form  {
    height: 1fr;
    padding: 1 3;
}
SettingsScreen .set-section {
    color: $cyan;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
}
SettingsScreen .set-label {
    color: $text_dim;
    margin-top: 1;
    margin-bottom: 0;
}
#f-api-key-status {
    color: $text_dim;
    margin-bottom: 1;
    padding-left: 1;
}
SettingsScreen Input {
    width: 60;
    background: $bg_input;
    border: tall $green_dim;
    color: $text;
}
SettingsScreen Input:focus {
    border: tall $cyan;
}
SettingsScreen Select {
    width: 60;
    background: $bg_input;
    border: tall $green_dim;
    color: $text;
}
SettingsScreen Select:focus {
    border: tall $cyan;
}
SettingsScreen #action-bar {
    align: right middle;
    padding: 0 2;
}

/* ── DiffReviewScreen ────────────────────────────────────────────────────── */
DiffReviewScreen { background: $bg; }
#diff-title  { color: $cyan; text-style: bold; }
#diff-ref    { color: $text_dim; }
#diff-status { color: $green; margin-top: 1; }
#diff-stats  {
    height: 1;
    background: $bg_panel;
    color: $green_body;
    padding: 0 2;
    border-bottom: solid $green_dim;
}
#split-view  { height: 1fr; layout: horizontal; }
#file-list   { width: 42; border-right: heavy $green 20%; }
#diff-log    { width: 1fr; }
DiffReviewScreen #action-bar  {
    height: 3;
}

/* ── AgentsScreen ────────────────────────────────────────────────────────── */
AgentsScreen { background: $bg; }
#ag-title { color: $cyan; text-style: bold; }
#ag-path  { color: $text_dim; }
#ag-split {
    height: 1fr;
    layout: vertical;
}
#ag-table {
    height: auto;
    max-height: 14;
    border-bottom: solid $green 20%;
}
#ag-pages {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green_dim;
    align: center middle;
    padding: 0 1;
}
#ag-page-label {
    color: $cyan;
    width: 1fr;
    text-align: center;
}
#btn-ag-prev, #btn-ag-next { min-width: 10; }
#ag-detail { height: 1fr; }
/* ── SkillsScreen ────────────────────────────────────────────────────────── */
SkillsScreen { background: $bg; }
#sk-title { color: $cyan; text-style: bold; }
#sk-path  { color: $text_dim; }
#sk-split {
    height: 1fr;
    layout: vertical;
}
#sk-table {
    height: auto;
    max-height: 14;
    border-bottom: solid $green 20%;
}
#sk-pages {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green_dim;
    align: center middle;
    padding: 0 1;
}
#sk-page-label {
    color: $cyan;
    width: 1fr;
    text-align: center;
}
#btn-sk-prev, #btn-sk-next { min-width: 10; }
#sk-detail { height: 1fr; }

/* ── AgentEditScreen / SkillEditScreen ───────────────────────────────────── */
AgentEditScreen { background: $bg; }
SkillEditScreen { background: $bg; }
#ag-edit-title  { color: $cyan; text-style: bold; }
#ag-edit-path   { color: $text_dim; }
#sk-edit-title  { color: $cyan; text-style: bold; }
#sk-edit-path   { color: $text_dim; }
AgentEditScreen TextArea,
SkillEditScreen TextArea {
    height: 10;
    border: tall $green_dim;
    background: $bg_input;
}
AgentEditScreen TextArea:focus,
SkillEditScreen TextArea:focus {
    border: tall $cyan;
}
AgentEditScreen SelectionList,
SkillEditScreen SelectionList {
    height: 10;
    border: tall $green_dim;
    background: $bg_input;
    color: $green_body;
}
AgentEditScreen SelectionList:focus,
SkillEditScreen SelectionList:focus {
    border: tall $cyan;
}
AgentEditScreen .set-label,
SkillEditScreen .set-label,
PlanEditorScreen .set-label,
TaskEditModal .set-label {
    color: $text_dim;
    margin-top: 1;
    margin-bottom: 0;
}
AgentEditScreen #set-form,
SkillEditScreen #set-form {
    height: 1fr;
    padding: 1 3;
}

/* ── PlanInspectScreen ───────────────────────────────────────────────────── */
PlanInspectScreen { background: $bg; }
PlanInspectScreen #insp-title { color: $cyan; text-style: bold; }
PlanInspectScreen #insp-path  { color: $text_dim; }
PlanInspectScreen #mode-tabs  {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green_dim 25%;
    align: left middle;
    padding: 0 1;
}
PlanInspectScreen #mode-tabs Button {
    min-width: 14;
    margin: 0 1;
}
PlanInspectScreen .tab-active {
    background: $green_dim;
    color: $bg;
    text-style: bold;
    border: solid $green 60%;
}
PlanInspectScreen #insp-split {
    height: 1fr;
    layout: horizontal;
}
PlanInspectScreen #insp-table {
    width: 42;
    border-right: heavy $green 20%;
}
PlanInspectScreen #insp-log { width: 1fr; }
PlanInspectScreen #action-bar {
    align: right middle;
    padding: 0 2;
}

/* ── EstimateScreen ──────────────────────────────────────────────────────── */
EstimateScreen { align: center middle; }
#card {
    width: 80; height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title { color: $cyan; text-style: bold; margin-bottom: 1; }
#mode-list  { height: 5; margin-bottom: 1; }
.field-label { color: $cyan; margin-top: 1; }
#btns { height: auto; align: right middle; margin-top: 1; }

/* ── EstimateResultScreen ────────────────────────────────────────────────── */
EstimateResultScreen { background: $bg; }
#est-title { color: $cyan; text-style: bold; }
#est-plan  { color: $text_dim; }
#est-log   { height: 1fr; }
EstimateResultScreen #action-bar {
    align: right middle;
    padding: 0 2;
}

/* ── HomeScreen ──────────────────────────────────────────────────────────── */
HomeScreen { background: $bg; }

#home-main {
    height: 1fr;
}

/* Nav panel: wide enough for key + label + short description inside box+padding */
#nav-panel {
    width: 62;
    min-width: 48;
    border-right: heavy $green 20%;
    layout: vertical;
}

#nav-hdr {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green_dim;
    align: left middle;
    padding: 0 1;
}

#nav-hdr-title {
    width: 1fr;
    color: $cyan;
    text-style: bold;
}

#btn-nav-toggle {
    height: 1;
    min-width: 5;
    width: 5;
    background: $cyan;
    color: $bg;
    border: none;
    margin: 0;
    padding: 0 1;
    text-style: bold;
}
#btn-nav-toggle:hover { background: $green; }

#nav-scroll {
    height: 1fr;
    overflow-y: auto;
}

#banner-box {
    width: 100%;
    background: $bg_panel;
    border: heavy $green 25%;
    padding: 1 2;
    margin-bottom: 1;
    align: center middle;
    height: auto;
}
#banner-art  { color: $green; text-style: bold; text-align: center; }
#tagline     { color: $cyan; text-align: center; text-style: italic; margin-top: 1; }

#menu-box {
    width: 100%;
    background: $bg_panel;
    border: heavy $green 20%;
    padding: 1 2;
    height: auto;
}
#menu-title  {
    color: $cyan;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    border-bottom: solid $green_dim;
}
.menu-row     { height: 1; margin: 0; }
.menu-divider { color: $text_dim; height: 1; margin: 0; }
.menu-key     { width: 5; color: $green; text-style: bold; }
.menu-label   { width: 16; color: $green; text-style: bold; }
.menu-desc    { color: $text_dim; }

/* Selected row highlight (toggled by HomeScreen.watch__cursor) */
.menu-row--selected .menu-key   { color: $amber;  text-style: bold; }
.menu-row--selected .menu-label { color: $green;  text-style: bold; }
.menu-row--selected .menu-desc  { color: $green_body; }

#status-bar {
    height: 2;
    padding: 0 2;
    color: $text_dim;
    background: $bg_input;
    border-top: solid $green_dim;
}

/* ── Nav collapsed state ─────────────────────────────────────────────────── */
HomeScreen.nav-collapsed #nav-panel {
    width: 10;
    min-width: 10;
}
HomeScreen.nav-collapsed #nav-hdr-title { display: none; }
HomeScreen.nav-collapsed #banner-box    { display: none; }
HomeScreen.nav-collapsed #menu-title    { display: none; }
HomeScreen.nav-collapsed .menu-label    { display: none; }
HomeScreen.nav-collapsed .menu-desc     { display: none; }
HomeScreen.nav-collapsed .menu-divider  { display: none; }
HomeScreen.nav-collapsed #menu-box {
    padding: 0 1;
    border: heavy $green 20%;
}
HomeScreen.nav-collapsed .menu-key {
    width: auto;
}

/* ── DashboardWidget ─────────────────────────────────────────────────────── */
#dashboard-panel {
    width: 1fr;
    padding: 0;
}

DashboardWidget {
    width: 1fr;
    height: 1fr;
    background: $bg_panel;
    padding: 0;
    layout: vertical;
}

/* Scrollable content: takes all height above the pinned action bar */
#dash-scroll {
    height: 1fr;
    overflow-y: auto;
    padding: 1 2 0 2;
}

#dash-header {
    height: 1;
    margin-bottom: 1;
}
#dash-title {
    color: $cyan;
    text-style: bold;
    width: 1fr;
}
#dash-active-badge {
    width: auto;
    color: $green;
    text-align: right;
}

#dash-stats-box {
    height: 1;
    color: $green_body;
}

#dash-rule-top  { color: $green_dim; margin: 0; }
#dash-rule-nav  { color: $green_dim; margin: 0; }
#dash-rule-mid  { color: $green_dim; margin: 0; }

/* ── Upper panel: runs list ── */
#dash-runs-label {
    color: $cyan;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}
#dash-runs-table {
    height: auto;
    border: solid $cyan 25%;
    margin-bottom: 0;
}
#dash-page-bar {
    height: 3;
    align: center middle;
    padding: 0;
}
#dash-page-label {
    width: 1fr;
    text-align: center;
    color: $cyan;
}
#btn-dash-pg-prev, #btn-dash-pg-next { min-width: 5; padding: 0 1; }

/* ── Lower panel: detail view ── */
#dash-stats {
    height: auto;
    margin-top: 1;
}

#dash-run-id   { color: $green_body; }
#dash-status   { }
#dash-progress { }
#dash-cost     { }
#dash-tokens   { }
#dash-elapsed  { }

#dash-tasks-title {
    color: $cyan;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

#dash-task-table {
    height: auto;
    border: solid $cyan 25%;
    margin-bottom: 0;
}
#dash-task-page-bar {
    height: 3;
    align: center middle;
    padding: 0;
}
#dash-task-page-label {
    width: 1fr;
    text-align: center;
    color: $cyan;
}
#btn-dash-tpg-prev, #btn-dash-tpg-next { min-width: 5; padding: 0 1; }

#dash-idle-msg {
    color: $text_dim;
    text-align: center;
    margin-top: 1;
}

/* Pinned action bar — always visible regardless of scroll position */
#dash-actions {
    height: auto;
    padding: 0 1 1 1;
    background: $bg_input;
    border-top: solid $green 20%;
    align: left middle;
}

/* Dashboard action buttons */
#btn-dash-open, #btn-dash-stop, #btn-dash-pause, #btn-dash-delete {
    min-width: 8;
}
