}
#ag-detail { height: 1fr; }
AgentsScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── SkillsScreen ────────────────────────────────────────────────────────── */
SkillsScreen { background: $bg; }
SkillsScreen #top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#sk-title { color: $cyan; text-style: bold; }
#sk-path  { color: $text_dim; }
#sk-split {
    height: 1fr;
    layout: vertical;
}
#sk-table {
    height: auto;
    max-height: 14;
    border-bottom: solid $green 20%;
}
#sk-pages {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green_dim;
    align: left middle;
    padding: 0 1;
}
#sk-page-label {
    color: $cyan;
    width: 1fr;
    text-align: center;
}
#btn-sk-prev, #btn-sk-next {
    min-width: 10;
    background: $bg_panel;
    color: $cyan;
    border: solid $cyan 40%;
}
#btn-sk-prev:disabled, #btn-sk-next:disabled {
    color: $text_dim;
    border: solid $text_dim 20%;
}
#sk-detail { height: 1fr; }
SkillsScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── AgentEditScreen / SkillEditScreen ───────────────────────────────────── */
AgentEditScreen { background: $bg; }
SkillEditScreen { background: $bg; }
#ag-edit-title  { color: $cyan; text-style: bold; }
#ag-edit-path   { color: $text_dim; }
#sk-edit-title  { color: $cyan; text-style: bold; }
#sk-edit-path   { color: $text_dim; }
AgentEditScreen TextArea,
SkillEditScreen TextArea {
    height: 10;
    border: tall $green_dim;
    background: $bg_input;
}
AgentEditScreen TextArea:focus,
SkillEditScreen TextArea:focus {
    border: tall $cyan;
}
AgentEditScreen SelectionList,
SkillEditScreen SelectionList {
    height: 10;
    border: tall $green_dim;
    background: $bg_input;
    color: $green_body;
}
AgentEditScreen SelectionList:focus,
SkillEditScreen SelectionList:focus {
    border: tall $cyan;
}
AgentEditScreen .set-label,
SkillEditScreen .set-label {
    color: $text_dim;
    margin-top: 1;
    margin-bottom: 0;
}

/* ── PlanInspectScreen ───────────────────────────────────────────────────── */
PlanInspectScreen { background: $bg; }
PlanInspectScreen #top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
PlanInspectScreen #insp-title { color: $cyan; text-style: bold; }
PlanInspectScreen #insp-path  { color: $text_dim; }
PlanInspectScreen #mode-tabs  {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green_dim 25%;
    align: left middle;
    padding: 0 1;
}
PlanInspectScreen #mode-tabs Button {
    min-width: 14;
    margin: 0 1;
}
PlanInspectScreen .tab-active {
    background: $green_dim;
    color: $bg;
    text-style: bold;
    border: solid $green 60%;
}
PlanInspectScreen #insp-split {
    height: 1fr;
    layout: horizontal;
}
PlanInspectScreen #insp-table {
    width: 42;
    border-right: heavy $green 20%;
}
PlanInspectScreen #insp-log { width: 1fr; }
PlanInspectScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: right middle;
    padding: 0 2;
}

/* ── EstimateScreen ──────────────────────────────────────────────────────── */
EstimateScreen { align: center middle; }
#card {
    width: 80; height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title { color: $cyan; text-style: bold; margin-bottom: 1; }
#mode-list  { height: 5; margin-bottom: 1; }
.field-label { color: $cyan; margin-top: 1; }
#btns { height: auto; align: right middle; margin-top: 1; }

/* ── EstimateResultScreen ────────────────────────────────────────────────── */
EstimateResultScreen { background: $bg; }
#top-bar {
    height: auto; background: $bg_panel;
    border-bottom: heavy $green 25%; padding: 1 2;
}
#est-title { color: $cyan; text-style: bold; }
#est-plan  { color: $text_dim; }
#est-log   { height: 1fr; }
#action-bar {
    height: 5; background: $bg_input;
    border-top: solid $green 25%; align: right middle; padding: 0 2;
}

/* ── HomeScreen ──────────────────────────────────────────────────────────── */
HomeScreen { background: $bg; }

#home-main {
    height: 1fr;
}

/* Nav panel: wide enough for key + label + short description inside box+padding */
#nav-panel {
    width: 62;
    min-width: 48;
    border-right: heavy $green 20%;
}

#banner-box {
    width: 100%;
    background: $bg_panel;
    border: heavy $green 25%;
    padding: 1 2;
    margin-bottom: 1;
    align: center middle;
    height: auto;
}
#banner-art  { color: $green; text-style: bold; text-align: center; }
#tagline     { color: $cyan; text-align: center; text-style: italic; margin-top: 1; }

#menu-box {
    width: 100%;
    background: $bg_panel;
    border: heavy $green 20%;
    padding: 1 2;
    height: auto;
}
#menu-title  {
    color: $cyan;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    border-bottom: solid $green_dim;
}
.menu-row     { height: 1; margin: 0; }
.menu-divider { color: $text_dim; height: 1; margin: 0; }
.menu-key     { width: 5; color: $green; text-style: bold; }
.menu-label   { width: 16; color: $green; text-style: bold; }
.menu-desc    { color: $text_dim; }

/* Selected row highlight (toggled by HomeScreen.watch__cursor) */
.menu-row--selected .menu-key   { color: $amber;  text-style: bold; }
.menu-row--selected .menu-label { color: $green;  text-style: bold; }
.menu-row--selected .menu-desc  { color: $green_body; }

#status-bar {
    height: 2;
    padding: 0 2;
    color: $text_dim;
    background: $bg_input;
    border-top: solid $green_dim;
}

/* ── DashboardWidget ─────────────────────────────────────────────────────── */
#dashboard-panel {
    width: 1fr;
    padding: 0;
}

DashboardWidget {
    width: 1fr;
    height: 1fr;
    background: $bg_panel;
    padding: 1 2;
    border-left: solid $green_dim;
}

#dash-title {
    color: $cyan;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#dash-stats-box {
    height: 1;
    color: $green_body;
    margin-bottom: 0;
}
#dash-nav {
    height: 3;
    align: center middle;
    padding: 0;
}
#dash-run-nav {
    width: 1fr;
    text-align: center;
    color: $cyan;
}
#btn-run-prev, #btn-run-next {
    min-width: 5;
    background: $bg_panel;
    color: $cyan;
    border: solid $cyan 40%;
}
#btn-run-prev:disabled, #btn-run-next:disabled {
    color: $text_dim;
    border: solid $text_dim 20%;
}
#dash-rule-top  { color: $green_dim; margin-bottom: 1; }
#dash-rule-nav  { color: $green_dim; margin-top: 0; margin-bottom: 1; }
#dash-rule-mid  { color: $green_dim; margin-top: 1; margin-bottom: 1; }
#dash-rule-bot  { color: $green_dim; margin-top: 1; margin-bottom: 0; }

#dash-stats {
    height: auto;
    margin-bottom: 1;
}

#dash-run-id   { color: $green_body; }
#dash-status   { margin-top: 1; }
#dash-progress { margin-top: 1; }
#dash-cost     { margin-top: 1; }
#dash-elapsed  { margin-top: 1; }

#dash-activity-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}

#dash-log {
    height: 1fr;
    background: $bg;
    border: solid $green_dim;
    padding: 0 1;
}

#dash-idle-msg {
    color: $text_dim;
    text-align: center;
    margin-top: 2;
}

#dash-actions {
    height: auto;
    padding: 0;
    margin-top: 0;
}

#btn-dash-open {
    background: #001a08;
    color: $green;
    border: tall $green;
    min-width: 10;
}
#btn-dash-open:disabled {
    background: $bg_panel;
    color: #0d200d;
    border: tall #0d200d;
}

#btn-dash-stop {
    background: #2a1400;
    color: $amber;
    border: tall $amber;
    min-width: 10;
}
#btn-dash-stop:disabled {
    background: $bg_panel;
    color: #1a0d00;
    border: tall #1a0d00;
}

#btn-dash-pause {
    background: #001530;
    color: $cyan;
    border: tall $cyan;
    min-width: 10;
}
#btn-dash-pause:disabled {
    background: $bg_panel;
    color: #000e20;
    border: tall #000e20;
}

#btn-dash-delete {
    background: #280008;
    color: $red;
    border: tall $red;
    min-width: 10;
}
#btn-dash-delete:disabled {
    background: $bg_panel;
    color: #180005;
    border: tall #180005;
}
