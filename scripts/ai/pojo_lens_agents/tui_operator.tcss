    max-height: 12;
}
RunDetailsScreen #events-title {
    color: $cyan;
    text-style: bold;
    background: $bg_panel;
    padding: 0 1;
}
RunDetailsScreen #events-log { height: 1fr; }
RunDetailsScreen #diff-header {
    color: $cyan;
    text-style: bold;
    background: $bg_panel;
    padding: 0 1;
}
RunDetailsScreen #diff-file-list {
    height: auto;
    max-height: 10;
    border-bottom: solid $green 20%;
}
RunDetailsScreen #diff-log { height: 1fr; }
RunDetailsScreen #action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: right middle;
    padding: 0 2;
}

/* ── ResumeRetryScreen ───────────────────────────────────────────────────── */
ResumeRetryScreen {
    background: $bg;
}
