/* ── Shared / Global ─────────────────────────────────────────────────────── */
Screen {
    background: $bg;
    color: $green_body;
}
Header {
    background: $bg_panel;
    color: $green;
    border-bottom: heavy $green 30%;
}
Footer {
    background: $bg_input;
    color: $text_dim;
    border-top: solid $green 20%;
}
.panel {
    background: $bg_panel;
    border: heavy $green 25%;
    padding: 1 2;
    margin: 0 0 1 0;
}
.panel-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
.section-rule {
    color: $green_dim;
}
.dim {
    color: $text_dim;
}
.warn {
    color: $amber;
}
.error {
    color: $red;
}
.ok {
    color: $green;
}
.accent {
    color: $cyan;
}
/* ── Global button styles — neon when enabled, dark when disabled ─────── */
Button {
    margin: 0 1;
    background: $bg_panel;
    color: $green;
    border: tall $green 50%;
    min-width: 12;
}
Button:hover   { background: $green_dim; color: $green; }
Button:disabled {
    background: $bg_panel;
    color: #0d200d;
    border: tall #0d200d;
}

Button.-primary {
    background: #001a08;
    color: $green;
    border: tall $green;
}
Button.-primary:hover    { background: #002a10; }
Button.-primary:disabled {
    background: $bg_panel;
    color: #0d200d;
    border: tall #0d200d;
}

Button.-warning {
    background: #2a1400;
    color: $amber;
    border: tall $amber;
}
Button.-warning:hover    { background: #3a1e00; }
Button.-warning:disabled {
    background: $bg_panel;
    color: #1a0d00;
    border: tall #1a0d00;
}

Button.-error {
    background: #280008;
    color: $red;
    border: tall $red;
}
Button.-error:hover    { background: #380010; }
Button.-error:disabled {
    background: $bg_panel;
    color: #180005;
    border: tall #180005;
}

/* ── Semantic button IDs — consistent color across all screens ────────── */
#btn-resume, #btn-ledger {
    background: #001530;
    color: $cyan;
    border: tall $cyan;
}
#btn-resume:disabled {
    background: $bg_panel;
    color: #000e20;
    border: tall #000e20;
}

#btn-retry {
    background: #2a1400;
    color: $amber;
    border: tall $amber;
}
#btn-retry:disabled {
    background: $bg_panel;
    color: #1a0d00;
    border: tall #1a0d00;
}

#btn-gate, #btn-abort {
    background: #280008;
    color: $red;
    border: tall $red;
}
#btn-gate:disabled {
    background: $bg_panel;
    color: #180005;
    border: tall #180005;
}

#btn-run-prev, #btn-run-next, #btn-prev, #btn-next {
    background: #001530;
    color: $cyan;
    border: tall $cyan;
    min-width: 4;
}
#btn-run-prev:disabled, #btn-run-next:disabled,
#btn-prev:disabled,     #btn-next:disabled {
    background: $bg_panel;
    color: #000e20;
    border: tall #000e20;
}
Input {
    background: $bg_input;
    color: $green;
    border: solid $green 40%;
}
Input:focus {
    border: solid $cyan;
    color: $cyan;
}
OptionList {
    background: $bg;
    border: solid $green_dim;
    color: $green_body;
}
OptionList > .option-list--option-highlighted {
    background: $green_dim;
    color: $green;
    text-style: bold;
}
DataTable {
    background: $bg_panel;
    color: $green_body;
}
DataTable > .datatable--header {
    background: $bg_input;
    color: $cyan;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: $green_dim;
}
DataTable > .datatable--even-row {
    background: $bg_panel;
}
DataTable > .datatable--odd-row {
    background: $bg;
}
RichLog {
    background: $bg;
    padding: 0 1;
    color: $green_body;
    scrollbar-color: $green 25%;
    scrollbar-background: $bg;
}
LoadingIndicator {
    color: $green;
    background: $bg;
}


/* ── GoalInputScreen ─────────────────────────────────────────────────────── */
GoalInputScreen {
    align: center middle;
}
#card {
    width: 76;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
#hint {
    color: $text_dim;
    margin-top: 1;
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* ── ClarificationScreen ─────────────────────────────────────────────────── */
ClarificationScreen {
    align: center middle;
}
#card {
    width: 82;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#cl-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#cl-wip {
    color: $amber;
    margin-bottom: 1;
}
#cl-goal-box {
    background: $bg_input;
    border: solid $green_dim;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}
#cl-goal-label { color: $cyan; }
#cl-goal-text  { color: $green_body; }
#cl-separator  { color: $green_dim; margin: 1 0; }
#cl-q-label {
    color: $cyan;
    text-style: bold;
    margin-bottom: 0;
}
#cl-q-text {
    color: $green_body;
    margin-bottom: 1;
}
#cl-progress {
    color: $text_dim;
    margin-bottom: 1;
}
#cl-answers {
    background: $bg_input;
    border: solid $green_dim;
    padding: 0 1;
    height: auto;
    margin-bottom: 1;
}
#cl-input {
    margin-top: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* ── EffortSelectScreen ──────────────────────────────────────────────────── */
EffortSelectScreen {
    align: center middle;
}
#card {
    width: 72;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
OptionList {
    height: 7;
    margin-bottom: 1;
}
#cost-note {
    color: $amber;
    margin-top: 1;
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* ── WorkspaceModeScreen ─────────────────────────────────────────────────── */
WorkspaceModeScreen {
    align: center middle;
}
#card {
    width: 76;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#card-title {
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}
#desc {
    color: $green_body;
    margin-bottom: 1;
}
OptionList {
    height: 7;
    margin-bottom: 1;
}
#ws-warning {
    color: $amber;
    margin-top: 1;
    margin-bottom: 1;
}
#btns {
    height: auto;
    align: right middle;
    margin-top: 1;
}

/* GovernanceScreen is an alias for RunConfigScreen — no separate CSS needed */

/* ── RunConfigScreen ─────────────────────────────────────────────────────── */
RunConfigScreen {
    align: center middle;
}
RunConfigScreen #card {
    width: 88;
    height: 1fr;
    max-height: 54;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
#provider-list { height: 6; margin-bottom: 0; }
#prov-config-note { color: $text_dim; height: auto; }
#prov-meta { color: $text_dim; height: auto; }
#gov-title { color: $cyan; text-style: bold; margin-top: 1; }

/* ── PromoteConfirmDialog ────────────────────────────────────────────────── */
PromoteConfirmDialog {
    align: center middle;
    background: $bg 60%;
}
PromoteConfirmDialog #confirm-dialog {
    width: 72;
    height: auto;
    border: heavy $green 30%;
    background: $bg_panel;
    padding: 2 3;
}
PromoteConfirmDialog #confirm-title { color: $cyan; text-style: bold; margin-bottom: 1; }
PromoteConfirmDialog #confirm-ref   { color: $text_dim; margin-bottom: 1; }
PromoteConfirmDialog #confirm-msg   { color: $amber; margin-bottom: 1; }
PromoteConfirmDialog #btns          { height: auto; align: right middle; margin-top: 1; }

/* ── PlanRunScreen (wizard + plan run — shared screen) ───────────────────── */
PlanRunScreen {
    background: $bg;
}

/* ── SavedPlansScreen ────────────────────────────────────────────────────── */
SavedPlansScreen {
    background: $bg;
}
#top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#screen-title {
    color: $cyan;
    text-style: bold;
}
#screen-hint {
    color: $text_dim;
}
#search-bar {
    height: 3;
    background: $bg_input;
    border-bottom: solid $green 20%;
    padding: 0 1;
}
#search-input {
    width: 1fr;
}
#plans-stats {
    height: 1;
    background: $bg_panel;
    color: $green_body;
    padding: 0 2;
    border-bottom: solid $green_dim;
}
#plans-table {
    height: 1fr;
}
#empty-notice {
    color: $text_dim;
    text-align: center;
    margin: 4;
}
#pagination-bar {
    height: 3;
    background: $bg_input;
    border-top: solid $green_dim;
    align: center middle;
    padding: 0 1;
}
#page-label {
    color: $cyan;
    width: 1fr;
    text-align: center;
}
#btn-prev, #btn-next {
    min-width: 5;
    background: $bg_panel;
    color: $cyan;
    border: solid $cyan 40%;
}
#btn-prev:disabled, #btn-next:disabled {
    color: $text_dim;
    border: solid $text_dim 20%;
}
#action-bar {
    height: 5;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── PlanDetailsScreen ───────────────────────────────────────────────────── */
PlanDetailsScreen {
    background: $bg;
}
#top-bar {
    height: auto;
    background: $bg_panel;
    border-bottom: heavy $green 25%;
    padding: 1 2;
}
#screen-title {
    color: $cyan;
    text-style: bold;
}
#plan-path {
    color: $text_dim;
}
#details-log {
    height: 1fr;
}
PlanDetailsScreen #action-bar {
    height: 7;
    background: $bg_input;
    border-top: solid $green 25%;
    align: left middle;
    padding: 0 1;
}

/* ── PlanEditorScreen ────────────────────────────────────────────────────── */
PlanEditorScreen {
    background: $bg;
